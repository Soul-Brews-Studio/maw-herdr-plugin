{
  "name": "herdr",
  "version": "26.10.3-alpha.1026",
  "sdk": "^1.0.0",
  "runtime": "bun-dev",
  "target": "js",
  "entry": "index.mjs",
  "description": "herdr workspaces, agents and the federation through maw's own verbs: ls, attach, wake, hey, peek, resolve, restart, resume, restore, kill, close, join, break, layout, whoami, watch, inbox, reply, audit, clean, sync, federation, serve",
  "capabilities": [
    "proc:exec:herdr",
    "proc:exec:go",
    "proc:exec",
    "fs:read",
    "fs:write",
    "net"
  ],
  "cli": {
    "command": "herdr",
    "help": "maw herdr <ls|list|a|attach|wake|hey|peek|read|resolve|restart|resume|restore|kill|close|join|here|break|back|layout|whoami|watch|inbox|reply|audit|clean|sync|federation|fed|serve> [--json] [--print] [--dry]",
    "interactive": true
  },
  "engine": {
    "serve": {
      "command": "bun index.mjs serve --engine",
      "prefix": "/api/herdr",
      "health": "/health"
    }
  }
}
