{
  "name": "herdr",
  "version": "0.2.0",
  "sdk": "^1.0.0",
  "runtime": "bun-dev",
  "target": "js",
  "entry": "index.mjs",
  "description": "herdr sessions and agents through maw's own verbs: ls, attach, wake, hey, peek",
  "capabilities": [
    "proc:exec:herdr"
  ],
  "cli": {
    "command": "herdr",
    "help": "maw herdr <ls|a|wake|hey|peek> [--json] [--print]",
    "interactive": true
  }
}
